# Copy to .env and fill in real values. Never commit .env.

# --- PostgreSQL ---
POSTGRES_DB=orchestrator
POSTGRES_USER=orchestrator_app
POSTGRES_PASSWORD=changeme
POSTGRES_AUDIT_USER=orchestrator_audit
POSTGRES_AUDIT_PASSWORD=changeme

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme
KEYCLOAK_REALM=hardening-console
# PHẢI là địa chỉ trình duyệt/client thật sự dùng để gọi token endpoint
# (Keycloak set "iss" trong JWT theo đúng URL này) — "localhost" chỉ đúng nếu
# trình duyệt và Keycloak chạy cùng máy. Mục "thống nhất 1 port": Keycloak
# không còn publish port riêng, browser đi qua reverse-proxy của Web (nginx,
# port 3000, xem apps/web/nginx.conf) — giá trị PHẢI dùng CHÍNH port 3000 đó
# (vd https://172.30.2.111:3000/realms/hardening-console), KHÔNG phải port
# cũ 8444/8080, nếu không token do Web UI lấy sẽ bị Orchestrator từ chối vì
# "iss" không khớp.
KEYCLOAK_ISSUER_URL=https://localhost:3000/realms/hardening-console
# Secret của client "orchestrator-admin" (service account, KHÁC hẳn
# KEYCLOAK_ADMIN_PASSWORD ở trên — đó là mật khẩu NGƯỜI QUẢN TRỊ đăng nhập
# Keycloak console, cái này là secret của 1 CLIENT dùng để Orchestrator tự
# gọi Keycloak Admin REST API cho tính năng Quản lý người dùng, xem
# app/keycloak_admin.py). Client này KHÔNG tự có sẵn sau khi import
# realm-export.json — phải chạy 1 lần
# ./infra/keycloak/bootstrap-admin-client.sh (xem file đó) để tạo + cấp role
# + in ra secret dán vào đây.
KEYCLOAK_ADMIN_CLIENT_SECRET=changeme

# --- step-ca ---
STEPCA_NAME=hardening-console-ca
STEPCA_DNS_NAMES=localhost,step-ca
STEPCA_PROVISIONER_PASSWORD=changeme

# --- Orchestrator ---
ORCHESTRATOR_SECRET_KEY=changeme
# Allowlist principal SSH cho scan/ssh-check qua Host.ssh_user (mục "sửa
# host", xem app/hosts.py), phân cách dấu phẩy — quyết định ở cấp triển
# khai, KHÔNG phải operator tự chọn tuỳ ý qua UI (provisioner "orchestrator"
# trên step-ca không tự giới hạn principal được phép cấp cert). Remediate/
# restore KHÔNG dùng biến này — luôn cứng "root" (cần quyền root để sửa
# /etc/ssh, /etc/pam.d, /etc/sysctl.d).
ALLOWED_SSH_USERS=root
# Khoá mã hoá Host.ssh_password_encrypted (mục "sửa host" — lưu THAM KHẢO,
# CHƯA dùng cho job pipeline nào). Sinh 1 lần bằng:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# LƯU Ý: đổi giá trị này SAU KHI đã có host lưu ssh_password sẽ khiến
# KHÔNG giải mã lại được các giá trị cũ (không có cơ chế xoay khoá/di trú).
HOST_CREDENTIAL_ENCRYPTION_KEY=changeme

# --- Job Dispatcher (nội bộ, không public — xem apps/job-dispatcher/README.md) ---
JOB_DISPATCHER_SHARED_SECRET=changeme
# Đường dẫn TUYỆT ĐỐI trên HOST DOCKER thật (không phải trong container
# job-dispatcher) tới scripts/content-signing/signed/ — job-dispatcher chạy
# Docker-outside-of-Docker (mount docker.sock, spawn container sibling qua
# job-net), bind-mount cho sibling PHẢI là đường dẫn trên host, không phải
# đường dẫn tương đối/bên trong container job-dispatcher. Dùng để mount
# read-only nội dung remediation đã ký vào execution-env lúc chạy job.
CONTENT_SIGNING_SIGNED_HOST_PATH=/opt/hardening-console/scripts/content-signing/signed

# --- Content Signing (xem scripts/content-signing/README.md) ---
# Fingerprint GPG của Signer tin cậy — Orchestrator truyền vào execution-env
# để remediate.sh/agent-install.sh verify chữ ký bundle trước khi chạy.
# KHÔNG đọc fingerprint tin cậy từ chính bundle đang verify.
CONTENT_SIGNING_TRUSTED_FINGERPRINT=changeme
# Tên thư mục bundle hiện hành trong scripts/content-signing/signed/, chứa
# agent+executor binary + provision.sh + 2 systemd unit — dùng bởi
# POST /hosts/{hostname}/agent-install (remote-deploy Agent tự động, xem
# apps/agent/README.md mục đóng gói bundle). Để RỖNG cho tới khi đã ký bundle
# đầu tiên qua đúng quy trình 3 vai trò — endpoint tự báo lỗi rõ ràng, không
# hard-required lúc khởi động.
AGENT_BUNDLE_REF=
# Fingerprint GPG tin cậy RIÊNG cho bundle agent — CỐ Ý khác
# CONTENT_SIGNING_TRUSTED_FINGERPRINT ở trên (dùng cho remediation), để đổi
# 1 trong 2 không làm hỏng verify của bên còn lại.
AGENT_BUNDLE_TRUSTED_FINGERPRINT=
# Địa chỉ Agent Manager THẬT mà Agent chạy trên máy đích (ngoài docker
# network này) gọi tới — PHẢI khớp "ports: 8443:8443" của service
# agent-manager, vd https://<IP thật của máy chạy docker-compose>:8443.
# KHÔNG dùng localhost/agent-manager (chỉ resolve được trong docker network
# nội bộ). Thiếu biến này, agent-install "chạy xong" nhưng Agent trên host
# thật sẽ KHÔNG enroll được — xem app/config.py:agent_manager_public_url.
AGENT_MANAGER_PUBLIC_URL=

# --- Agent Manager (nội bộ, xem apps/agent-manager/README.md) ---
AGENT_MANAGER_SHARED_SECRET=changeme

# --- TLS thật cho Keycloak/Orchestrator/Web (xem infra/keycloak/README.md,
# apps/web/README.md) — thay cho sslRequired="none" tạm thời trước đây ---
KEYCLOAK_TLS_SHARED_SECRET=changeme
WEB_TLS_SHARED_SECRET=changeme
# IP/hostname LAN mà TRÌNH DUYỆT dùng để truy cập (KHÔNG phải "localhost" —
# phải là địa chỉ thật, PHẢI khớp giá trị dùng trong KEYCLOAK_ISSUER_URL/
# VITE_*_URL bên dưới, nếu không cert TLS sẽ không khớp tên miền browser
# gõ vào thanh địa chỉ). Cùng giá trị AGENT_MANAGER_PUBLIC_URL đang dùng
# (khác mục đích: đây là SAN cho cert, không phải URL cho Agent thật).
PUBLIC_HOST=changeme

# --- Active Response (Agent thực thi remediation thật — xem app/jobs.py) ---
# Kill-switch TOÀN CỤC, mặc định false (tắt) — chỉ bật sau khi Executor đã
# qua pentest riêng. Còn cần bật thêm PER-HOST qua
# PATCH /hosts/{hostname}/active-response trước khi host đó thật sự dùng
# đường Agent thay vì SSH agentless.
ACTIVE_RESPONSE_ENABLED=false

# --- Web UI (apps/web) ---
# Origin Web UI được serve, dùng để cấu hình CORS ở Orchestrator (mục
# "thống nhất 1 port": giờ không còn cross-origin call nào từ SPA nữa —
# /api và /realms đều same-origin qua nginx reverse-proxy — biến này gần như
# không còn tác dụng thật, giữ lại làm lớp phòng thủ phụ, không xoá).
WEB_ORIGIN=https://localhost:3000
# Bake vào bundle JS lúc build (Vite build-arg) — KHÔNG còn VITE_API_BASE_URL/
# VITE_KEYCLOAK_URL (client.ts/keycloak.ts dùng same-origin qua nginx, xem
# apps/web/nginx.conf) — chỉ 2 biến dưới, không phụ thuộc IP/hostname truy cập.
VITE_KEYCLOAK_REALM=hardening-console
VITE_KEYCLOAK_CLIENT_ID=web
