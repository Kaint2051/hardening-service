# Copy to .env and fill in real values. Never commit .env.

# --- PostgreSQL ---
POSTGRES_DB=orchestrator
POSTGRES_USER=orchestrator_app
POSTGRES_PASSWORD=changeme
POSTGRES_AUDIT_USER=orchestrator_audit
POSTGRES_AUDIT_PASSWORD=changeme

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme
KEYCLOAK_REALM=hardening-console
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/hardening-console

# --- step-ca ---
STEPCA_NAME=hardening-console-ca
STEPCA_DNS_NAMES=localhost,step-ca
STEPCA_PROVISIONER_PASSWORD=changeme

# --- Orchestrator ---
ORCHESTRATOR_SECRET_KEY=changeme
